# Settings for polycap. Put overrides in ~/.config/polycap/env (chmod 600; polycap refuses it otherwise)
# or the environment, which wins. Every setting has a safe default. The keys marked SECRET hold
# credentials: they go in that file or the server's env file, never in docs, logs or commits.
# POLYCAP_CONFIG (a process environment variable, not an env-file option) names another env file. The
# Mac app reads the same file for POLYCAP_ROOT and POLYCAP_HOOKS, refusing it too when others can read it.
# POLYCAP_CONFIG=~/.config/polycap/env

# Where recordings, bundles and the ledger live. Created with owner-only permissions.
POLYCAP_ROOT=~/PolydanceCapture

# Tool binaries, if not on PATH.
POLYCAP_ADB=adb
POLYCAP_FFMPEG=ffmpeg
POLYCAP_FFPROBE=ffprobe

# Transcription: whisper-cpp (local, nothing leaves the machine), gladia (sends the narration wav;
# for a call, the mic and the call's sound, so the other participants' voices too; it does not tell
# the other speakers apart yet; deletes the jobs afterwards) or none.
POLYCAP_TRANSCRIBER=whisper-cpp
# SECRET. Needed for POLYCAP_TRANSCRIBER=gladia.
# GLADIA_API_KEY=
# POLYCAP_GLADIA_URL=https://api.gladia.io
# 1 keeps jobs at Gladia instead of deleting them after reading (debugging only).
# POLYCAP_GLADIA_KEEP_JOBS=
POLYCAP_WHISPER_BIN=whisper-cli
# Download once: see private/docs/HANDOVER.md. ~1.6 GB for large-v3-turbo.
POLYCAP_WHISPER_MODEL=~/PolydanceCapture/models/ggml-large-v3-turbo.bin
POLYCAP_LANGUAGE=en
# 0 lets whisper choose its own thread count.
POLYCAP_THREADS=0

# A title and one sentence per recording: none (default, nothing is sent) or claude (sends the
# transcript text only to Anthropic's API).
POLYCAP_SUMMARIZER=none
# SECRET. Needed for POLYCAP_SUMMARIZER=claude.
# ANTHROPIC_API_KEY=
# The cheapest current model by default; any Claude model id works.
# POLYCAP_SUMMARY_MODEL=claude-haiku-4-5
# POLYCAP_ANTHROPIC_URL=https://api.anthropic.com

# What each pointing frame shows, so "this" reads "the TRY label on the CAP-1 row" in the storyboard:
# none (default, nothing is sent) or claude, which sends each pointing frame (at most 24 a recording;
# frames can show the room) and the line being said to Anthropic's API. Uses ANTHROPIC_API_KEY.
POLYCAP_POINTING=none
# POLYCAP_POINTING_MODEL=claude-haiku-4-5

# Who of the Others spoke each line of a Meet call, from the ring Meet draws round the speaking tile and
# the name on it (docs/MAC.md P3a): meet (default) reads the recording on this Mac with polydance-speakers,
# built by `npm run mac -- speakers`, and sends nothing anywhere; none leaves Others' lines unnamed. The
# names are written into the bundle's transcript and speakers.json, never into session.json; with
# POLYCAP_SUMMARIZER=claude they go to Anthropic as part of the transcript.
POLYCAP_SPEAKERS=meet
# Where the reader is; by default mac/build/polydance-speakers in the checkout polycap runs from.
# POLYCAP_SPEAKERS_BIN=

# Frames: cap per session, output width, interval when there is no transcript.
POLYCAP_MAX_FRAMES=80
POLYCAP_FRAME_WIDTH=1024
POLYCAP_FRAME_INTERVAL_MS=5000

# Scene-change frames, where the screen changed (docs/DESIGN.md): calls (default: recordings imported
# with a call in --meta), all (any recording; a headset's every head turn would count) or none.
POLYCAP_SCENES=calls
# ffmpeg's scene score, between 0 and 1, above which a frame counts as a change. 0.03 keeps slides on
# one template whose text changes (measured 0.036 to 0.046) and leaves steady motion out.
POLYCAP_SCENE_THRESHOLD=0.03
# Scene frames per recording, capped apart from POLYCAP_MAX_FRAMES and thinned evenly past it.
POLYCAP_MAX_SCENES=120

# Pull safety: a file must keep the same size and mtime across this gap, and be at least this old.
POLYCAP_STABLE_MS=5000
POLYCAP_MIN_AGE_MS=15000

# Comma-separated remote folders to watch, overriding the device profile.
# POLYCAP_DEVICE_FOLDERS=/sdcard/Movies,/sdcard/DCIM

# Hosted receiver, client side: `polycap sync` downloads finished bundles from here.
# https, or http only on this machine or the local network.
# POLYCAP_REMOTE_URL=https://capture.example.net
# SECRET. A read token from `polycap token new --scope read`; add --scope post for an agent to post in threads.
# `polycap connect CODE`, with a code from Polydance on your headset, writes both of these lines for you.
# POLYCAP_REMOTE_TOKEN=
# SECRET. `polycap upload` (a walkthrough from the Mac as a thread reply) needs a token with the upload scope,
# which the read token above does not have. Either the name of one saved by
#   polycap token new --id mac-capture --scope upload --scope read --user robin --label Mac --save mac-capture
# (it lives in ~/.config/polycap/tokens/mac-capture; the receiver must list the line it prints), or the token itself.
# Empty: polycap upload refuses and says how to make one. The Mac app's uploads use this.
# POLYCAP_UPLOAD_TOKEN=mac-capture

# Routine hooks (docs/MAC.md "Starting Robin's routine"): what runs when a bundle is ready, a JSON file
# (version 1), your own and chmod 600 (refused otherwise). No file: no hooks. `polycap hooks list` shows
# them and `polycap doctor` checks them. A hook does not inherit ANTHROPIC_*, CLAUDE_CODE_*, GLADIA_API_KEY
# or polycap's tokens from polycap; its own "env" in hooks.json can set them.
# POLYCAP_HOOKS=~/.config/polycap/hooks.json

# Hosted receiver, server side (`polycap serve`): the tokens it accepts, as the JSON lines
# `polycap token new` prints (sha256 hashes only, so not secret, but keep the list private).
# POLYCAP_SERVER_TOKENS=[{"id":"quest3","sha256":"...","scopes":["upload"]}]
# A token for someone outside the team carries "threads":"member" and their "user" (polycap token new --member):
# it reaches, and with read syncs, only the threads that person is a member of (docs/THREADS.md, Who sees a thread).
# Projects turn threads on (docs/THREADS.md): each with a key, a name, and the hosts and packages its
# launches may open. Unset means threads are off and uploads make sessions as before.
# POLYCAP_PROJECTS=[{"key":"MUS","name":"Marimba","hosts":["marimba-web-*-yourteam.vercel.app"],"packages":["com.example.marimba"]}]
# People, so messages say who sent them: a token names its user ("user":"robin") and its label the device.
# POLYCAP_USERS=[{"id":"robin","name":"Robin","colour":"#d93a2b"}]
# The project reports from the headset's bug key go to (docs/THREADS.md, Reports): one of POLYCAP_PROJECTS.
# Each report opens a thread there that only read/post tokens see. Unset means the receiver refuses reports.
# POLYCAP_REPORTS=CAP
# Private Meta Quest beta (private/docs/STORE.md). All three are required together; unset means sign-in is off.
# POLYCAP_META_APP_ID=1300818073125870
# SECRET. This app's Meta dashboard secret, receiver only, never in the APK or a client config.
# POLYCAP_META_APP_SECRET=
# Any valid app-entitled account can enroll unless blocked, up to maxTesters. NOT a channel-membership check.
# projects is the default shared scope; per-account projects override it only for explicitly mapped Meta IDs.
# maxBytes is optional (otherwise POLYCAP_ALLOWANCE_BYTES). people maps attribution ONLY, not ownership.
# accounts maps VERIFIED app-scoped Meta IDs to {user, projects, legacyGrantIds}; operator linking only.
# Use deploy/receiver/link-meta-account.py after matching the headset ID to a fresh verified enrollment.
# Aliases enable history/deletion and combined quota; they never rewrite old records or revive deletions.
# blockedUsers denies both restored tokens and new sign-ins; restart receiver after edits.
# POLYCAP_META_TESTERS={"projects":["MUS"],"maxTesters":25,"maxBytes":2000000000,"people":{},"accounts":{},"blockedUsers":[]}
# Default upstream; override only for controlled testing. Never point the real app secret at a test server.
# POLYCAP_META_GRAPH_URL=https://graph.oculus.com

# Google sign-in for Android XR testers (private/docs/PLAY.md): off unless both are set. The web OAuth client ID
# from Google Cloud → Credentials (the app is built with the same ID); no secret is needed. Admission is
# the invited list of addresses Google verified; blocked wins; people maps an invited address to someone
# in POLYCAP_USERS. Removing or blocking an address takes effect on restart.
# POLYCAP_GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnop.apps.googleusercontent.com
# POLYCAP_GOOGLE_TESTERS={"projects":["MUS"],"invited":["tester@example.com"],"maxTesters":25,"blocked":[],"people":{}}
# Tests only: a stand-in for Google's published keys on this machine.
# POLYCAP_GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
# The Welcome (docs/THREADS.md, The Welcome): the project a newcomer's Welcome thread opens in when they sign in,
# and the getting-started page its launch opens (served at /start). The project's hosts must include the page's
# host. Unset means no Welcome. deploy/receiver/enable-welcome.py sets it on the live receiver.
# POLYCAP_WELCOME={"project":"START","url":"https://capture.example.net/start"}
# Whether someone added to a thread from now on (by the team, or by an invited address they confirmed) sees what
# was posted before, unless whoever on the team adds them chooses (--history; docs/THREADS.md, Who sees a thread).
# hidden, the default: only what came after, as in most messaging apps. visible: all of it. The choice is kept with
# each person, so changing this never reveals anything to people already added. The team always sees everything.
# POLYCAP_NEW_MEMBER_HISTORY=hidden
# Email (docs/HOSTED.md, Email): invitations to addresses the team copies into threads, and links that confirm
# a person's own address. Unset means no email. provider ahasend or folder (writes to <root>/mail-outbox, sends nothing).
# POLYCAP_MAIL={"provider":"ahasend","accountId":"<AhaSend account or sub-account id>","from":{"email":"invitations@mail.example.net","name":"Polydance"},"replyTo":{"email":"you@example.net"},"tags":["polydance"],"sandbox":true}
# SECRET. An AhaSend API key scoped to messages:send:{your sending domain} only; receiver only.
# POLYCAP_AHASEND_KEY=
# POLYCAP_AHASEND_URL=https://api.ahasend.com
# The receiver's own address, for the links in an email: https, or http://localhost:PORT with the folder mailer.
# POLYCAP_PUBLIC_URL=https://capture.example.net
# Asking to join (private/docs/SITE.md, The form): the homepage's form posts to /join, and each request is emailed to notify
# (needs POLYCAP_MAIL), with a reply going to the person asking. site is where the form is; bits is the proof of
# work's difficulty (18, the default, is about a second on a laptop; the form's data-bits must match). Unset means
# /join answers 404.
# POLYCAP_JOIN={"notify":"you@example.net","site":"https://www.example.net"}
# A real monitored contact address for /privacy and /start; confirm with the owner before publishing the notice.
# POLYCAP_PRIVACY_CONTACT=

# Android and Mac build tools (these are process environment variables, not polycap env-file options).
# POLYCAP_ANDROID_SIGNING=/absolute/path/to/owner-only/upload.properties
# POLYCAP_OVR_PLATFORM_UTIL=/absolute/path/to/ovr-platform-util
# JAVA_HOME=/absolute/path/to/jdk17
# ANDROID_HOME=/absolute/path/to/android-sdk
# Mac app build (mac/build.sh): the code-signing identity, when the first "Apple Development" certificate
# in the keychain is not the one to use. It must stay the same between builds (macOS ties every grant to it).
# POLYCAP_MAC_SIGN_IDENTITY="Apple Development: Name (TEAMID)"
# iPhone build (ios/build.sh, ios/README.md): the signing team, when it is not the first team in Xcode's
# accounts (Settings, Accounts), and the phone, when more than one paired iPhone can be reached.
# POLYCAP_IOS_TEAM=<10-character team id>
# POLYCAP_IOS_DEVICE=<the phone's name or its id from npm run ios -- devices>

# Largest single upload accepted, in bytes (default 4 GiB).
POLYCAP_MAX_UPLOAD_BYTES=4294967296
# Each upload token's storage allowance (a grant's maxBytes overrides it). 8 GB is about 2 h at 1080p.
POLYCAP_ALLOWANCE_BYTES=8000000000
# Server-wide safety net: past HIGH bytes of recordings, the oldest finished are deleted down to LOW.
POLYCAP_STORAGE_HIGH_BYTES=13000000000
POLYCAP_STORAGE_LOW_BYTES=11000000000
# People outside the team (thread-scoped tokens, signed-in testers whose person holds no team token): a smaller
# allowance, and the days a recording of theirs keeps its video before the video alone is deleted, the bundle kept.
# Empty (the default): the allowance above, and video kept until deleted. capture.polydance.net: 2 GB and 30 days.
POLYCAP_MEMBER_ALLOWANCE_BYTES=
POLYCAP_MEMBER_VIDEO_DAYS=
# 3D models pushed with thread messages (polycap thread reply --model chair.glb): the largest one, at most
# 62914560 (60 MiB, under nginx's 64m), and all of them together. They are kept until removed by hand.
POLYCAP_MODEL_MAX_BYTES=50000000
POLYCAP_MODELS_TOTAL_BYTES=2000000000
# Photos in thread messages (polycap thread reply --photo shot.png, the iPhone, the Mac): the largest one, at
# most 62914560 (60 MiB, under nginx's 64m), and all of them together. Kept until removed by hand.
POLYCAP_PHOTO_MAX_BYTES=20000000
POLYCAP_PHOTOS_TOTAL_BYTES=2000000000
